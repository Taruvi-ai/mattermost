# Mattermost Environment Variables

# PostgreSQL Settings
POSTGRES_USER=mmuser
POSTGRES_PASSWORD=mostest
POSTGRES_DB=mattermost
POSTGRES_PORT=5435

# Mattermost Server Settings
MATTERMOST_PORT=8065
MM_SERVICESETTINGS_SITEURL=http://localhost:8065
MM_LOGSETTINGS_CONSOLELEVEL=INFO

# Database Connection
MM_SQLSETTINGS_DATASOURCE=postgres://mmuser:mostest@postgres:5432/mattermost?sslmode=disable

# Keycloak Authentication Settings (takes priority over Taruvi when enabled)
MM_KEYCLOAKSETTINGS_ENABLE=true
MM_KEYCLOAKSETTINGS_SERVERURL=https://your-keycloak.com
MM_KEYCLOAKSETTINGS_REALM=your-realm
MM_KEYCLOAKSETTINGS_CLIENTID=your-client-id
MM_KEYCLOAKSETTINGS_CLIENTSECRET=your-client-secret
MM_KEYCLOAKSETTINGS_CONNECTIONTIMEOUT=10

# Taruvi Authentication Settings (fallback when Keycloak is disabled)
MM_TARUVISETTINGS_ENABLE=false
MM_TARUVISETTINGS_TARUVISERVERURL=http://taruvi_web:8000/sites/appbuild
MM_TARUVISETTINGS_AUTHENDPOINT=/_allauth/app/v1/auth/login
MM_TARUVISETTINGS_USERENDPOINT=/api/users/me/
MM_TARUVISETTINGS_CONNECTIONTIMEOUT=10
MM_TARUVISETTINGS_OVERRIDEHOST=false
MM_TARUVISETTINGS_HOSTOVERRIDEVALUE=localhost:8000
